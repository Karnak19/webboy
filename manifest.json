{
  "manifest_version": 3,
  "name": "Webboy",
  "version": "0.1.0",
  "description": "Ton bon boy qui fait la recherche web pour toi — propulsé par OpenCode Go.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Webboy"
  },
  "background": {
    "service_worker": "background/main.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": ["https://opencode.ai/*", "<all_urls>"]
}
